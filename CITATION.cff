cff-version: 1.2.0
message: >-
  If you use ace-jax in published work, cite the atomic cluster expansion
  (Drautz 2019) and ACEpotentials.jl (Witt et al. 2023), which are in the
  references. If you use the calibrated force uncertainty (--uq ard), also
  cite Kermode (2026). If you use PACE .yace models, also cite Lysogorskiy
  et al. (2021).
title: "ace-jax: fit and evaluate ACE interatomic potentials in Python/JAX"
type: software
authors:
  - name: ACEsuit contributors
license: MIT
repository-code: "https://github.com/ACEsuit/ace-jax"
url: "https://acesuit.github.io/ace-jax/"
keywords:
  - atomic cluster expansion
  - interatomic potential
  - JAX
  - molecular dynamics
  - uncertainty quantification
references:
  - type: article
    scope: "Cite for all use of ace-jax: the atomic cluster expansion."
    title: "Atomic cluster expansion for accurate and transferable interatomic potentials"
    authors:
      - family-names: Drautz
        given-names: Ralf
        orcid: "https://orcid.org/0000-0001-7101-8804"
    journal: "Physical Review B"
    volume: 99
    start: "014104"
    year: 2019
    doi: 10.1103/PhysRevB.99.014104
  - type: article
    scope: "Cite for all use of ace-jax: its models and fits follow ACEpotentials.jl."
    title: "ACEpotentials.jl: A Julia implementation of the atomic cluster expansion"
    authors:
