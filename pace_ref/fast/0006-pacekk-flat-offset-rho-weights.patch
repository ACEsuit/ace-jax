 /* ----------------------------------------------------------------------
+   Device, PACE_KK_RHOW=2: ComputeRho and ComputeWeights in the stock thread layout (a team = one
+   ms-combination over team_size_fo consecutive atoms, so the per-term table reads are uniform across a
+   warp and the A / weight accesses coalesce over atoms), with every subscript a precomputed flat offset
+   (d_fo_*) instead of mus / ns / ls / ms_combs lookups and 4-d index arithmetic, and no division by
+   chunk_size per thread.  Ranks 2-4 are unrolled (the factors stay in registers); the leave-one-out
+   products come from prefix / suffix products.
+------------------------------------------------------------------------- */
+
+template<class DeviceType>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+typename PairPACEKokkos<DeviceType>::complex
+PairPACEKokkos<DeviceType>::fo_read(const int ii, const int code) const
+{
+  const int o = ii + fo_sA * (code >> 2);
+  complex a;
+  a.re = A_sph_re.data()[o];
+  a.im = A_sph_im.data()[o];
+  if (code & 1) {               // m < 0: conjugate symmetry, as read_A
+    const KK_FLOAT factor = (code & 2) ? -1.0 : 1.0;
+    a.re = a.re * factor;
+    a.im = -a.im * factor;
+  }
+  return a;
+}
+
+template<class DeviceType>
+template<int R>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+typename PairPACEKokkos<DeviceType>::complex
+PairPACEKokkos<DeviceType>::fo_product(const int ii, const int c, const int mu_i) const
+{
+  complex B = fo_read(ii, d_fo_A(c, 0, mu_i));
+  #pragma unroll
+  for (int t = 1; t < R; t++) B = B * fo_read(ii, d_fo_A(c, t, mu_i));
+  return B;
+}
+
+template<class DeviceType>
+template<int R>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::fo_weights(const int ii, const int c, const int mu_i, const KK_FLOAT theta) const
+{
+  complex v[R], pre[R];
+  #pragma unroll
+  for (int t = 0; t < R; t++) v[t] = fo_read(ii, d_fo_A(c, t, mu_i));
+  pre[0] = complex::one();
+  #pragma unroll
+  for (int t = 1; t < R; t++) pre[t] = pre[t - 1] * v[t - 1];
+  complex suf = complex::one();
+  #pragma unroll
+  for (int t = R - 1; t >= 0; t--) {
+    const complex dB = pre[t] * suf;
+    suf = suf * v[t];
+    const int w = d_fo_W(c, t, mu_i);
+    if (w >= 0) {
+      const complex value = theta * dB;
+      Kokkos::atomic_add(&weights_re.data()[ii + fo_sW * w], value.re);
+      Kokkos::atomic_add(&weights_im.data()[ii + fo_sW * w], value.im);
+    }
+    const int wm = d_fo_Wm(c, t, mu_i);
+    if (wm >= 0) {
+      const complex valuem = theta * dB.conj() * (KK_FLOAT)((wm & 1) ? -1 : 1);
+      Kokkos::atomic_add(&weights_re.data()[ii + fo_sW * (wm >> 1)], valuem.re);
+      Kokkos::atomic_add(&weights_im.data()[ii + fo_sW * (wm >> 1)], valuem.im);
+    }
+  }
+}
+
+template<class DeviceType>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::operator() (TagPairPACEComputeRhoFO,
+    const typename Kokkos::TeamPolicy<DeviceType, TagPairPACEComputeRhoFO>::member_type& team) const
+{
+  const int nb = (chunk_size + team.team_size() - 1) / team.team_size();
+  const int c = team.league_rank() / nb;
+  const int ii = (team.league_rank() - c * nb) * team.team_size() + team.team_rank();
+  if (ii >= chunk_size) return;
+  const int mu_i = d_map(type(d_ilist[ii + chunk_offset]));
+  if (c >= d_idx_ms_combs_count(mu_i)) return;
+  const int ndensity = d_ndensity(mu_i);
+  const int rank = d_tm_rank(c, mu_i);
+  if (rank == 1) {
+    const KK_FLOAT A_cur = A_rank1.data()[ii + fo_sA1 * d_fo_A(c, 0, mu_i)];
+    for (int p = 0; p < ndensity; ++p) Kokkos::atomic_add(&rhos(ii, p), d_ctildes(mu_i, c, p) * A_cur);
+    return;
+  }
+  const complex B = rank == 2 ? fo_product<2>(ii, c, mu_i) : rank == 3 ? fo_product<3>(ii, c, mu_i)
+                                                                      : fo_product<4>(ii, c, mu_i);
+  for (int p = 0; p < ndensity; ++p) Kokkos::atomic_add(&rhos(ii, p), B.real_part_product(d_ctildes(mu_i, c, p)));
+}
+
+template<class DeviceType>
+// NOLINTNEXTLINE
+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::operator() (TagPairPACEComputeWeightsFO,
+    const typename Kokkos::TeamPolicy<DeviceType, TagPairPACEComputeWeightsFO>::member_type& team) const
+{
+  const int nb = (chunk_size + team.team_size() - 1) / team.team_size();
+  const int c = team.league_rank() / nb;
+  const int ii = (team.league_rank() - c * nb) * team.team_size() + team.team_rank();
+  if (ii >= chunk_size) return;
+  const int mu_i = d_map(type(d_ilist[ii + chunk_offset]));
+  if (c >= d_idx_ms_combs_count(mu_i)) return;
+  const int ndensity = d_ndensity(mu_i);
+  const int rank = d_tm_rank(c, mu_i);
+  KK_FLOAT theta = 0.0;
+  for (int p = 0; p < ndensity; ++p) theta += dF_drho(ii, p) * d_ctildes(mu_i, c, p);
+  if (rank == 1) {
+    Kokkos::atomic_add(&weights_rank1.data()[ii + fo_sW1 * d_fo_A(c, 0, mu_i)], theta);
+    return;
+  }
+  theta *= 0.5;   // as ComputeWeights
+  if (rank == 2) fo_weights<2>(ii, c, mu_i, theta);
+  else if (rank == 3) fo_weights<3>(ii, c, mu_i, theta);
+  else fo_weights<4>(ii, c, mu_i, theta);
+}
