+struct LeafPerm { std::vector<int> nodes; std::vector<double> coefs; };
+static const LeafPerm &leaf_perm(ACEDAG &dag) {
+    static std::map<const ACEDAG *, LeafPerm> cache;
+    auto it = cache.find(&dag);
+    if (it != cache.end()) return it->second;
+    LeafPerm &lp = cache[&dag];
+    const int n2i = dag.get_num2_int(), n2l = dag.get_num2_leaf();
+    const int *nd = dag.nodes.get_data(); const double *cf = dag.coeffs.get_data();
+    int S = 16;   // interleave 16 contiguous chunks
+    int chunk = (n2l + S - 1) / S;
+    for (int q = 0; q < chunk; q++) for (int c = 0; c < S; c++) {
+        int k = c * chunk + q; if (k >= n2l) continue;
+        lp.nodes.push_back(nd[2 * (n2i + k)]); lp.nodes.push_back(nd[2 * (n2i + k) + 1]); lp.coefs.push_back(cf[n2i + k]);
+    }
+    return lp;
+}
