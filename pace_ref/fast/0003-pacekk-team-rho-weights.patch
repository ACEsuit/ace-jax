+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::operator() (TagPairPACEComputeRhoWeightsTeam,
+    const typename Kokkos::TeamPolicy<DeviceType, TagPairPACEComputeRhoWeightsTeam>::member_type& team) const
+{
+  const int ii = team.league_rank();
+  const int i = d_ilist[ii + chunk_offset];
+  const int mu_i = d_map(type(i));
+  const int ndensity = d_ndensity(mu_i);
+  const int nterms = d_idx_ms_combs_count(mu_i);
+  const int nn = nradmax + 1;
+  const int nA = nelements * idx_sph_max * nn;
+
+  KK_FLOAT *sAre = (KK_FLOAT *) team.team_shmem().get_shmem(nA * sizeof(KK_FLOAT));
+  KK_FLOAT *sAim = (KK_FLOAT *) team.team_shmem().get_shmem(nA * sizeof(KK_FLOAT));
+  KK_FLOAT *sWre = (KK_FLOAT *) team.team_shmem().get_shmem(nA * sizeof(KK_FLOAT));
+  KK_FLOAT *sWim = (KK_FLOAT *) team.team_shmem().get_shmem(nA * sizeof(KK_FLOAT));
+  KK_FLOAT *srho = (KK_FLOAT *) team.team_shmem().get_shmem(PACE_TEAM_NDMAX * sizeof(KK_FLOAT));
+
+  Kokkos::parallel_for(Kokkos::TeamThreadRange(team, nA), [&](const int e) {
+    const int n = e % nn, rest = e / nn, idx = rest % idx_sph_max, mu = rest / idx_sph_max;
+    sAre[e] = A_sph_re(ii, mu, idx, n);
+    sAim[e] = A_sph_im(ii, mu, idx, n);
+    sWre[e] = 0.0;
+    sWim[e] = 0.0;
+  });
+  Kokkos::parallel_for(Kokkos::TeamThreadRange(team, nelements * nradbase), [&](const int e) {
+    weights_rank1(ii, e / nradbase, e % nradbase) = 0.0;
+  });
+  Kokkos::parallel_for(Kokkos::TeamThreadRange(team, PACE_TEAM_NDMAX), [&](const int p) { srho[p] = 0.0; });
+  team.team_barrier();
+
+  // A entry from scratch: m < 0 through the conjugate symmetry, as read_A
+  auto sread = [&](const int code) {
+    const int e = code >> 2;
+    complex a;
+    a.re = sAre[e];
+    a.im = sAim[e];
+    if (code & 1) {
+      const KK_FLOAT factor = (code & 2) ? -1.0 : 1.0;
+      a.re = a.re * factor;
+      a.im = -a.im * factor;
+    }
+    return a;
+  };
+
+  // forward: densities
+  KK_FLOAT rho[PACE_TEAM_NDMAX];
+  for (int p = 0; p < PACE_TEAM_NDMAX; ++p) rho[p] = 0.0;
+  for (int c = team.team_rank(); c < nterms; c += team.team_size()) {
+    const int rank = d_tm_rank(c, mu_i);
+    if (rank == 1) {
+      const int o = d_tm_A(c, 0, mu_i);
+      const KK_FLOAT A_cur = A_rank1(ii, o / nradbase, o % nradbase);
+      for (int p = 0; p < ndensity; ++p) rho[p] += d_ctildes(mu_i, c, p) * A_cur;
+    } else {
+      complex B = sread(d_tm_A(c, 0, mu_i));
+      for (int t = 1; t < rank; t++) B = B * sread(d_tm_A(c, t, mu_i));
+      for (int p = 0; p < ndensity; ++p) rho[p] += B.real_part_product(d_ctildes(mu_i, c, p));
+    }
+  }
+  for (int p = 0; p < ndensity; ++p) Kokkos::atomic_add(&srho[p], rho[p]);
+  team.team_barrier();
+
+  // FS once per atom (rhos -> dF_drho, energy); the weights need no zeroing here
+  Kokkos::single(Kokkos::PerTeam(team), [&]() {
+    for (int p = 0; p < ndensity; ++p) rhos(ii, p) += srho[p];
+    compute_fs_one(ii, false);
+  });
+  team.team_barrier();
