 /* ----------------------------------------------------------------------
+   Device: ComputeRho + ComputeFS + ComputeWeights for one atom per team.
+   The atom's A_sph block (all mu, packed (l, m >= 0), n) is staged in
+   level-0 scratch, so the products and the leave-one-out products read
+   shared memory instead of global; the densities are summed in registers
+   and reduced in the team; FS runs once; the weights accumulate with
+   shared-memory atomics and are written back once (no global atomics, no
+   separate zeroing pass).  Same arithmetic per term as ComputeRho and
+   ComputeWeights; only the summation order of rho and the weights changes.
+------------------------------------------------------------------------- */
+
+template<class DeviceType>
