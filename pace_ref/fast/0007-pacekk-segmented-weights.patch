+KOKKOS_INLINE_FUNCTION
+void PairPACEKokkos<DeviceType>::operator() (TagPairPACEComputeWeightsSeg,
+    const typename Kokkos::TeamPolicy<DeviceType, TagPairPACEComputeWeightsSeg>::member_type& team) const
+{
+  const int nb = (chunk_size + team.team_size() - 1) / team.team_size();
+  const int sg = team.league_rank() / nb;
+  const int ii = (team.league_rank() - sg * nb) * team.team_size() + team.team_rank();
+  if (ii >= chunk_size) return;
+  const int mu_i = d_map(type(d_ilist[ii + chunk_offset]));
+  const int ndensity = d_ndensity(mu_i);
+  KK_FLOAT dF[PACE_TEAM_NDMAX];
+  for (int p = 0; p < ndensity; ++p) dF[p] = dF_drho(ii, p);
+
+  if (sg == sg_nseg_max) {
+    const int nr1 = d_sg_nr1(mu_i);
+    for (int k = 0; k < nr1; k++) {
+      const int c = d_sg_r1(k, mu_i);
+      KK_FLOAT theta = 0.0;
+      for (int p = 0; p < ndensity; ++p) theta += dF[p] * d_ctildes(mu_i, c, p);
+      Kokkos::atomic_add(&weights_rank1.data()[ii + fo_sW1 * d_fo_A(c, 0, mu_i)], theta);
+    }
+    return;
+  }
+  if (sg >= d_sg_nseg(mu_i)) return;
+
+  int cur = -1;
+  KK_FLOAT acc_re = 0.0, acc_im = 0.0;
+  for (int q = 0; q < PACE_SEG; q++) {
+    const int row = sg * PACE_SEG + q;
+    const int code = d_sg_tgt(row, mu_i);
+    if (code < 0) break;
+    const int w = code >> 6;
+    if (w != cur) {
+      if (cur >= 0) {
+        Kokkos::atomic_add(&weights_re.data()[ii + fo_sW * cur], acc_re);
+        Kokkos::atomic_add(&weights_im.data()[ii + fo_sW * cur], acc_im);
+      }
+      cur = w; acc_re = 0.0; acc_im = 0.0;
+    }
+    const int c = d_sg_term(row, mu_i);
+    KK_FLOAT theta = 0.0;
+    for (int p = 0; p < ndensity; ++p) theta += dF[p] * d_ctildes(mu_i, c, p);
+    theta *= 0.5;   // as ComputeWeights
+    const int nf = (code >> 3) & 7;
+    complex dB = fo_read(ii, d_sg_f(row, 0, mu_i));
+    for (int t = 1; t < nf; t++) dB = dB * fo_read(ii, d_sg_f(row, t, mu_i));
+    if (code & 1) { acc_re += theta * dB.re; acc_im += theta * dB.im; }
+    if (code & 2) {
